# ============================================================
# Backend environment (copy to backend/.env)
# ============================================================

ENVIRONMENT=development
DEBUG=true

# SQLite is used by default so the backend runs without PostgreSQL.
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/jkt48_monitor
DATABASE_URL=sqlite+aiosqlite:///./jkt48_monitor.db

# 48pedia.id Public API key (https://48pedia.id/register)
JKT48_API_KEY=
JKT48_API_BASE_URL=https://api.48pedia.id/v1

POLL_INTERVAL_SECONDS=60
ENABLE_SCHEDULER=true
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
MAX_MANUAL_REFRESH_PER_MINUTE=4

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRE_MINUTES=720

TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=false

CORS_ORIGINS=http://localhost:3000
