# ============================================================
# JKT48 Availability Monitor - Docker Compose environment
# Copy to ".env" and fill in real values. NEVER commit ".env".
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=jkt48
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=jkt48_monitor
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
# Used by the backend container to reach PostgreSQL
DATABASE_URL=postgresql+asyncpg://jkt48:change_me_strong_password@db:5432/jkt48_monitor

# 48pedia.id Public API (https://api.48pedia.id/v1) - REQUIRED for live data.
# Register a free key at https://48pedia.id/register
JKT48_API_KEY=
JKT48_API_BASE_URL=https://api.48pedia.id/v1

# Polling interval (seconds). 60 is the target; honor provider rate limits.
POLL_INTERVAL_SECONDS=60
ENABLE_SCHEDULER=true

# Auth: seeded admin account (change before exposing the app!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
JWT_SECRET=change_me_jwt_secret_please
JWT_EXPIRE_MINUTES=720

# Telegram bot (create with @BotFather). Leave empty to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=false

# CORS: comma separated origins for the browser frontend
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Public base URL of the backend, consumed by the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
